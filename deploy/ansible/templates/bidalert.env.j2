# Managed by Ansible - edits are overwritten.
BIDALERT_DATABASE_URL={{ bidalert_database_url }}
BIDALERT_SOURCES={{ bidalert_sources }}
BIDALERT_CPPP_MAX_PAGES={{ bidalert_cppp_max_pages }}
BIDALERT_OUTPUT_DIR=/var/lib/bidalert/output
BIDALERT_SITE_DIR=/srv/bidalert/site
BIDALERT_HTTP_CACHE_DIR=/var/lib/bidalert/cache
BIDALERT_LOG_FORMAT=json
BIDALERT_ALERTS_ENABLED={{ bidalert_alerts_enabled | lower }}
{% for key, value in bidalert_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}

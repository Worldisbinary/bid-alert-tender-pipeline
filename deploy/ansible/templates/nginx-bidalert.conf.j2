# Managed by Ansible. Same layout as deploy/nginx/bidalert.compose.conf: dashboard at /,
# API at /api/ (systemd unit bidalert-api on 127.0.0.1:8000).
upstream bidalert_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=bidalert_api:10m rate=10r/s;

server {
    listen 80;
    server_name {{ bidalert_server_name }};
    server_tokens off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        proxy_pass http://bidalert_api/health;
    }

    location = /api/metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://bidalert_api/metrics;
    }

    location /api/ {
        limit_req zone=bidalert_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://bidalert_api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        root /srv/bidalert/site;
        index index.html;
        try_files $uri $uri/ =404;
        expires 5m;
    }
}

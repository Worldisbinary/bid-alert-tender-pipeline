# Copy to .env and edit. Never commit .env. Every variable is optional.

# Storage: SQLite by default; Postgres in docker-compose / production.
BIDALERT_DATABASE_URL=sqlite:///data/bidalert.db
# BIDALERT_DATABASE_URL=postgresql+psycopg://bidalert:change-me@localhost:5432/bidalert

# Sources: cppp (live, public CPPP listing), fixtures (recorded CPPP pages), synthetic (demo)
BIDALERT_SOURCES=cppp
BIDALERT_CPPP_MAX_PAGES=5
BIDALERT_HTTP_MIN_INTERVAL_S=3
# BIDALERT_PROFILE=config/my_profile.toml

# Outputs
BIDALERT_OUTPUT_DIR=output
BIDALERT_SITE_DIR=site

# Logging: json (default) or text
BIDALERT_LOG_FORMAT=json
BIDALERT_LOG_LEVEL=INFO

# Alerts are OFF unless enabled AND a channel is configured.
BIDALERT_ALERTS_ENABLED=false
# BIDALERT_SMTP_HOST=smtp.example.org
# BIDALERT_SMTP_PORT=587
# BIDALERT_SMTP_USERNAME=
# BIDALERT_SMTP_PASSWORD=
# BIDALERT_EMAIL_FROM=alerts@example.org
# BIDALERT_EMAIL_TO=you@example.org,team@example.org
# BIDALERT_TELEGRAM_BOT_TOKEN=
# BIDALERT_TELEGRAM_CHAT_ID=
